# GitHub PR Review Bot — Environment Configuration
# Copy to .env and fill in your values. Never commit real secrets.

# Application
NODE_ENV=development
PORT=3000

# GitHub App (required)
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_REPOSITORY_ALLOWLIST=pkcoder-9785/gihub-pr-riview
GITHUB_BOT_AUTHOR_ALLOWLIST=

# PostgreSQL (shared durable budget and publication state)
DATABASE_URL=postgresql://app:change-me@localhost:5432/code_pr_review

# OpenAI (required)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# Inngest (required in production)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Review configuration (optional)
REVIEW_OWNER=pkcoder-9785
REVIEW_MAX_FILES=30
REVIEW_MAX_INPUT_CHARS=80000
REVIEW_MAX_INPUT_TOKENS=24000
REVIEW_MAX_OUTPUT_TOKENS=4000
REVIEW_MAX_FINDINGS=5
REVIEW_GLOBAL_CONCURRENCY=5
REVIEW_DAILY_TOKEN_LIMIT=100000
REVIEW_GLOBAL_DAILY_TOKEN_LIMIT=500000
REVIEW_PR_DAILY_TOKEN_LIMIT=50000
# Start the pilot in a safe disabled state; set false only after live checks.
REVIEW_KILL_SWITCH=true
